# Asks the user before Git commands that publish or destroy work.
# Codex counterpart of .claude/hooks/guard-git.sh; loads only when this project is trusted.

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Publishes commits; needs the user's authorization.",
    match = ["git push", "git push --force origin main"],
    not_match = ["git pull"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "prompt",
    justification = "Discards commits and working-tree changes.",
    match = ["git reset --hard HEAD~1"],
    not_match = ["git reset HEAD file.txt"],
)

prefix_rule(
    pattern = ["git", "clean", ["-f", "-fd", "-df", "-fdx", "-xdf", "-ffd", "-ffdx"]],
    decision = "prompt",
    justification = "Deletes untracked files.",
    match = ["git clean -fd"],
    not_match = ["git clean -n"],
)

prefix_rule(
    pattern = ["git", "branch", "-D"],
    decision = "prompt",
    justification = "Force-deletes a branch, including unmerged work.",
    match = ["git branch -D feature"],
    not_match = ["git branch -d feature"],
)

prefix_rule(
    pattern = ["git", "checkout", "."],
    decision = "prompt",
    justification = "Discards all working-tree changes.",
    match = ["git checkout ."],
    not_match = ["git checkout main"],
)

prefix_rule(
    pattern = ["git", "checkout", "--", "."],
    decision = "prompt",
    justification = "Discards all working-tree changes.",
    match = ["git checkout -- ."],
)

prefix_rule(
    pattern = ["git", "restore", "."],
    decision = "prompt",
    justification = "Discards all working-tree changes.",
    match = ["git restore ."],
    not_match = ["git restore src/a.ts"],
)
