{
  "name": "vscode-review",
  "displayName": "VS Code review",
  "description": "Opens the Changes editor, with the sidebar closed, in a session worktree, on start-up and when sessions review asks.",
  "publisher": "local",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "bun test",
    "link": "mkdir -p ~/.vscode/extensions && ln -sfn \"$(pwd)\" ~/.vscode/extensions/local.vscode-review"
  }
}
