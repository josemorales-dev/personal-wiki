.DS_Store
.claude/settings.local.json
.claude/skills/synced/
~$*

# The global gitignore hides agent config; this hub tracks it.
!AGENTS.md
!CLAUDE.md
!.agents/
!.claude/

# Codex project config (rules) lives in the repo; overrides the global ignore
!.codex/

# Live session state belongs to this machine; archived sessions are tracked.
.agents/sessions/
.agents/tools/sessions/node_modules/

# The global PROJECT.md ignore also matches this template on a case-insensitive disk.
!.agents/skills/agents-obsidian-workflow/assets/Templates/Project.md
